{
  "entities": {
    "tenant": {
      "title": "Tenant",
      "description": "A Chama or SACCO group organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "currency", "status"]
    },
    "member": {
      "title": "Member",
      "description": "A registered Chama or SACCO member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "nationalId": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Super Admin", "Chairman", "Treasurer", "Secretary", "Member"] },
        "status": { "type": "string", "enum": ["Active", "Pending", "Suspended", "Exited"] },
        "joinedDate": { "type": "string" }
      },
      "required": ["id", "tenantId", "name", "role", "status"]
    },
    "contribution": {
      "title": "Contribution",
      "description": "Financial contribution record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["Completed", "Pending", "Failed"] },
        "method": { "type": "string" }
      },
      "required": ["id", "tenantId", "memberId", "amount", "status", "type"]
    },
    "loan": {
      "title": "Loan",
      "description": "Loan application and repayment lifecycle record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "principal": { "type": "number" },
        "interestRate": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "tenantId", "memberId", "principal", "status"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "tenant",
      "description": "Collection of all Chama and SACCO tenants"
    },
    "/members/{memberId}": {
      "schema": "member",
      "description": "Collection of members across organizations"
    },
    "/contributions/{contributionId}": {
      "schema": "contribution",
      "description": "Collection of contribution payments"
    },
    "/loans/{loanId}": {
      "schema": "loan",
      "description": "Collection of loans"
    }
  }
}
